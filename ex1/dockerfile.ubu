FROM ubuntu:22.04

WORKDIR /progetto1

COPY req.txt .

RUN apt-get update && apt-get install -y python3-pip && pip3 install --trusted-host pypi.org --trusted-host pypi.python.org --trusted-host files.pythonhosted.org -r req.txt

COPY app ./app
COPY data ./data

CMD ["uvicorn", "app.mainn:app", "--host", "0.0.0.0", "--port", "8000"]